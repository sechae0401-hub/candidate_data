# ── Supabase (항상 필수) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI provider 선택 ──
# openai(기본) 또는 gemini. 미설정 시 openai로 동작
AI_PROVIDER=openai

# ── OpenAI (AI_PROVIDER=openai일 때 필수) ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# ── Gemini (AI_PROVIDER=gemini일 때만 필요) ──
# GEMINI_MODEL 미설정 시 기본값 gemini-2.0-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
